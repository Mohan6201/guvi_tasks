# ============================================================
# Trend App - Central Deployment Configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored. Do NOT put AWS access keys / secret keys here -
# Terraform and the AWS CLI use your already-configured local identity
# (`aws configure` / SSO), and Jenkins uses its own credential store
# (see jenkins/Jenkinsfile's `credentials('dockerhub-creds')`) - keys
# never need to touch disk in this file.
# ============================================================

# --- Terraform variables (TF_VAR_ prefix required so Terraform reads
#     them automatically once exported) ---
TF_VAR_aws_region=us-east-1
TF_VAR_environment=production
TF_VAR_cluster_name=trend-eks-cluster
# Must be a currently AWS-supported EKS version - check with:
# aws eks describe-cluster-versions --query 'clusterVersions[?status==`STANDARD_SUPPORT`].clusterVersion'
TF_VAR_eks_version=1.33
TF_VAR_node_instance_type=t3.medium
TF_VAR_jenkins_instance_type=t2.medium
# Must be an EC2 key pair that already exists in this AWS account/region
TF_VAR_key_name=my-key-pair

# --- DockerHub ---
# Username only (not secret) - used to tag images for local manual testing.
# The actual push password/token is entered once in Jenkins' own
# credential store (ID: dockerhub-creds), never stored in this file.
DOCKERHUB_USERNAME=your_dockerhub_username

# --- Jenkins global environment variables ---
# (also entered manually in Jenkins > Manage Jenkins > System > Global
# Properties - documented here so both places stay in sync)
EKS_CLUSTER_NAME=trend-eks-cluster
AWS_DEFAULT_REGION=us-east-1
