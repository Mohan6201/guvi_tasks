# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
# NOTE: dist/ is intentionally NOT ignored for this project - the
# vendor-provided "Trend" repo ships only a prebuilt dist/, with no
# source/package.json to regenerate it from (see dist/README.md from
# the upstream repo). It IS the source as far as this repo is
# concerned, so it must be committed for Jenkins/Docker builds to have
# anything to COPY from a fresh clone.
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl

# AWS credentials
.aws/

# Docker
.dockerignore

# Jenkins
jenkins/workspace/
jenkins/builds/
