{
  "dashboard": {
    "id": null,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/\"}[1m])) / sum(machine_cpu_cores) * 100",
            "legendFormat": "CPU %",
            "refId": "A"
          }
        ],
        "title": "Cluster CPU Usage (%)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "id": 2,
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{id=\"/\"}) / sum(machine_memory_bytes) * 100",
            "legendFormat": "Memory %",
            "refId": "A"
          }
        ],
        "title": "Cluster Memory Usage (%)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 0
        },
        "id": 3,
        "targets": [
          {
            "expr": "sum(container_fs_usage_bytes{id=\"/\",device=\"/dev/nvme0n1p1\"}) / sum(container_fs_limit_bytes{id=\"/\",device=\"/dev/nvme0n1p1\"}) * 100",
            "legendFormat": "Filesystem %",
            "refId": "A"
          }
        ],
        "title": "Cluster Filesystem Usage (%)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "id": 4,
        "targets": [
          {
            "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
            "refId": "A"
          }
        ],
        "title": "Node Count (Ready)",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 14
        },
        "id": 5,
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace!=\"\",container!=\"\"}[5m])) by (namespace, pod)",
            "legendFormat": "{{namespace}}/{{pod}}",
            "refId": "A"
          }
        ],
        "title": "Pod CPU Usage (cores) - by pod",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 23
        },
        "id": 6,
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace!=\"\",container!=\"\"}) by (namespace, pod) / 1024 / 1024",
            "legendFormat": "{{namespace}}/{{pod}}",
            "refId": "A"
          }
        ],
        "title": "Pod Memory Usage (MB) - by pod",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 32
        },
        "id": 7,
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1) by (namespace)",
            "legendFormat": "{{namespace}}",
            "refId": "A"
          }
        ],
        "title": "Running Pods per Namespace",
        "type": "timeseries"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "timezone": "browser",
    "title": "Trend Cluster Health",
    "uid": "trend-cluster-health",
    "version": 1
  },
  "overwrite": true
}