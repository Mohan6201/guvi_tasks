# ============================================================
# Brain Tasks App - Central Deployment Configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored (never committed). Every setup script
# (iam-setup.sh, ecr-setup.sh, eks-setup.sh, codebuild-setup.sh,
# codepipeline-setup.sh, k8s/deploy.sh) sources this single file,
# so changing a value here changes it everywhere - no more hunting
# through scripts for hardcoded names.
#
# Do NOT put AWS access keys / secret keys in here. Local scripts
# use your `aws configure`/SSO credentials; CodeBuild uses the IAM
# service role created by iam-setup.sh. Keys never need to touch disk.
# ============================================================

# --- AWS account / region ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# --- Application ---
APP_NAME=brain-tasks-app
APP_PORT=3000
CONTAINER_PORT=80
IMAGE_TAG=latest

# --- ECR (Registry) ---
ECR_REPOSITORY_NAME=brain-tasks-app

# --- EKS (Kubernetes) ---
EKS_CLUSTER_NAME=brain-tasks-cluster
EKS_K8S_VERSION=1.31
EKS_NODE_GROUP_NAME=brain-tasks-nodes
EKS_NODE_TYPE=t3.medium
EKS_DESIRED_NODES=2
EKS_MIN_NODES=1
EKS_MAX_NODES=3
K8S_NAMESPACE=brain-tasks

# --- IAM roles (created idempotently by iam-setup.sh) ---
EKS_CLUSTER_ROLE_NAME=EKSClusterRole
EKS_NODE_ROLE_NAME=EKSNodeRole
CODEBUILD_SERVICE_ROLE_NAME=CodeBuildServiceRole
CODEPIPELINE_SERVICE_ROLE_NAME=CodePipelineServiceRole

# --- CodeBuild ---
CODEBUILD_BUILD_PROJECT=brain-tasks-app-build
CODEBUILD_DEPLOY_PROJECT=brain-tasks-app-deploy
CODEBUILD_IMAGE=aws/codebuild/amazonlinux2-x86_64-standard:5.0

# --- Source repository ---
# The GitHub repo CodeBuild/CodePipeline will pull from.
GITHUB_REPO_URL=https://github.com/<your-username>/<your-repo>.git
GITHUB_BRANCH=main
# If Brain-Tasks-App lives inside a subfolder of that repo (monorepo),
# set the relative path here so build/deploy commands `cd` into it first.
# Leave empty if the repo root IS the Brain-Tasks-App project.
SOURCE_DIR=

# --- CodePipeline ---
CODEPIPELINE_NAME=brain-tasks-app-pipeline
CODEPIPELINE_ARTIFACT_BUCKET=brain-tasks-app-pipeline-artifacts
# One-time manual step: AWS Console -> Developer Tools -> Settings -> Connections
# -> Create connection (GitHub) -> authorize -> copy the ARN here once status = Available.
CODESTAR_CONNECTION_ARN=arn:aws:codestar-connections:us-east-1:123456789012:connection/REPLACE_ME

# --- CloudWatch (Monitoring) ---
CLOUDWATCH_LOG_GROUP=/aws/codebuild/brain-tasks-app
