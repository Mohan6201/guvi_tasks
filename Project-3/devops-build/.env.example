# Wrap any value containing #, spaces, $, or backticks in single quotes, e.g.
# DOCKERHUB_PASSWORD='abc#123'. Loaded via `set -a; source .env; set +a` — see
# README Step 3 for why that command specifically (not export+grep+xargs).

# ============================================================
# AWS Credentials
# ============================================================
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# ============================================================
# EC2 Config
# ============================================================
EC2_KEY_NAME=my-ec2-key

# ============================================================
# DockerHub Credentials
# Used by build.sh, deploy.sh and configured in Jenkins
# ============================================================
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_PASSWORD=your_dockerhub_password_or_token

# ============================================================
# App Server (deploy.sh SSHes here — Jenkins gets these three via its
# own credentials instead, not from this file)
# ============================================================
APP_SERVER_HOST=1.2.3.4
APP_SERVER_SSH_USER=ubuntu
APP_SERVER_SSH_KEY_PATH=./my-ec2-key.pem

# ============================================================
# Monitoring — Alertmanager Email Notifications
# Use a Gmail App Password (not your main password)
# Generate at: Google Account > Security > App Passwords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_EMAIL=your-alert-email@example.com
