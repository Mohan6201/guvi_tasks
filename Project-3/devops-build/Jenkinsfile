pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS     = credentials('dockerhub-creds')
        DOCKERHUB_USERNAME  = "${DOCKERHUB_CREDS_USR}"
        DOCKERHUB_PASSWORD  = "${DOCKERHUB_CREDS_PSW}"
        IMAGE_TAG           = "${env.BUILD_NUMBER}"
        // checkout scm pulls the whole guvi_tasks monorepo into the workspace root —
        // the Script Path setting only tells Jenkins where to find this Jenkinsfile,
        // it doesn't change cwd for the steps below, so every sh step must cd here.
        APP_DIR             = "Project-3/devops-build"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Determine Target Repo') {
            steps {
                script {
                    // BRANCH_NAME is set by Multibranch Pipeline jobs directly (no
                    // "origin/" prefix to strip); GIT_BRANCH is the fallback for a
                    // plain Pipeline-from-SCM job run.
                    def branch = env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceAll('origin/', '') ?: 'dev'
                    if (branch == 'master' || branch == 'main') {
                        env.TARGET_REPO = "${DOCKERHUB_USERNAME}/prod"
                    } else {
                        env.TARGET_REPO = "${DOCKERHUB_USERNAME}/dev"
                    }
                    echo "Branch: ${branch} → Target repo: ${env.TARGET_REPO}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir(APP_DIR) {
                    sh '''
                        docker build -t ${TARGET_REPO}:${IMAGE_TAG} .
                        docker tag ${TARGET_REPO}:${IMAGE_TAG} ${TARGET_REPO}:latest
                    '''
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                dir(APP_DIR) {
                    sh '''
                        echo "$DOCKERHUB_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                        docker push ${TARGET_REPO}:${IMAGE_TAG}
                        docker push ${TARGET_REPO}:latest
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir(APP_DIR) {
                    withCredentials([
                        sshUserPrivateKey(credentialsId: 'app-server-ssh-key', keyFileVariable: 'APP_SERVER_SSH_KEY_PATH', usernameVariable: 'APP_SERVER_SSH_USER'),
                        string(credentialsId: 'app-server-host', variable: 'APP_SERVER_HOST')
                    ]) {
                        sh '''
                            chmod +x deploy.sh
                            ./deploy.sh
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "Build #${env.BUILD_NUMBER} succeeded — deployed ${env.TARGET_REPO}:${env.IMAGE_TAG}"
        }
        failure {
            echo "Build #${env.BUILD_NUMBER} failed — check console output"
        }
    }
}
